; showcase.fe — Comprehensive feature showcase for the ES6 rxi/fe interpreter

(print "=== 1. Atoms, Strings, Escapes, Numbers & Quotes ===")
(= greeting "Hello, fe!")
(= escaped "tab:\t newline:\n quote:\" slash:\\")
(= sym-val 'symbolic-token)
(= quoted-list '(10 20 30))
(= dotted-pair '(a . b))
(print "greeting:" greeting)
(print "escaped:" escaped)
(print "sym:" sym-val "quoted:" quoted-list "dotted:" dotted-pair)

(print "=== 2. Cons Pairs, Lists, Predicates & Mutation ===")
(= pair (cons "left" "right"))
(= nums (list 1 2 3 4))
(setcar pair "first")
(setcdr pair "second")
(setcar nums 100)
(setcdr (cdr nums) (list 25 3 4))
(print "pair:" pair "car:" (car pair) "cdr:" (cdr pair))
(print "nums:" nums "atom?:" (atom nums) "100 atom?:" (atom 100))

(= reverse (fn (lst)
  (= acc nil)
  (while lst
    (= acc (cons (car lst) acc))
    (= lst (cdr lst)))
  acc))
(print "reversed:" (reverse (list "a" "b" "c" "d")))

(print "=== 3. Arithmetic, Comparisons & Equality ===")
(= x 12)
(= y 5)
(print "+:" (+ x y) "-:" (- x y) "neg:" (- y))
(print "*:" (* x y) "/:" (/ x y) "recip:" (/ y))
(print "<:" (< y x) "<=:" (<= y 5) "==:" (== x 12) ">:" (> x y) ">=:" (>= x 12))
(print "nil==false:" (is nil false) "list eq:" (is (list 1 2) '(1 2)))

(print "=== 4. Closures, Lexical State & Scoped let ===")
(= make-counter (fn (start step)
  (= count start)
  (fn (delta)
    (if delta
      (= count (+ count delta))
      (= count (+ count step)))
    count)))

(= counter (make-counter 0 2))
(print "c1:" (counter))
(print "c2:" (counter 8))
(print "c3:" (counter))

(= branch-demo (fn (flag)
  (let v 1)
  (if flag
    (do
      (let v 42)
      (print "inner v:" v))
    (print "false branch v:" v))
  v))
(print "outer v (t):" (branch-demo t))
(print "outer v (nil):" (branch-demo nil))

(print "=== 5. Variadic Functions & Macros ===")
(= join-with-tag (fn (tag . rest)
  (cons tag rest)))
(print "variadic fn:" (join-with-tag "items" "one" "two" "three"))

(= unless (mac (cond body)
  (list 'if (list 'is cond nil) body)))

(= collect (mac args
  (cons 'list args)))

(unless nil
  (print "unless ran because cond is nil"))
(print "variadic mac:" (collect (+ 1 1) (* 3 3) 'done))

(print "=== 6. Built-in & Custom JS Functions (<jsfunc>) ===")
(print "builtin +:" + "builtin print:" print)

(print "=== 7. JS Interop (js-get, js-call, js-fn, js-new) ===")
(print "Math.PI:" (js-get "Math.PI"))
(print "Math.max:" (js-call "Math.max" 4 19 11))
(= scale10 (js-fn (fn (n) (* n 10))))
(print "wrapped fn:" scale10 "call via js-call:" (js-call scale10 7))

(print "=== 8. Dynamic eval & Control Flow ===")
(= program '((fn (n) (* n n)) 9))
(print "eval result:" (eval program))
(= countdown 3)
(= log-countdown nil)
(while (> countdown 0)
  (= log-countdown (cons countdown log-countdown))
  (= countdown (- countdown 1)))
(print "countdown collected:" (reverse log-countdown))
