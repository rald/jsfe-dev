; apps.fe — Built-in S-expression desktop applications

(os-def-app sexp-notes
  (title "S-Exp Notes")
  (icon "N")
  (width 440)
  (height 360)
  (render (fn (win)
    (let log (os-win-add-log win))
    (let ta (os-win-add-textarea win "(quote ((note welcome \"All is a list in Sweetie-16\") (storage \"root/notes.sexp\")))"))
    (os-win-add-button win "Load root/notes.sexp" (fn ()
      (let txt (os-read-file "root/notes.sexp"))
      (os-set-log log txt "frosting")))
    (os-win-add-button win "Save to root/notes.sexp" (fn ()
      (let val (os-get-value ta))
      (os-write-file "root/notes.sexp" val)
      (os-set-log log "Saved to root/notes.sexp" "pistachio")))
    (os-win-add-button win "Eval S-Exp" (fn ()
      (let val (os-get-value ta))
      (let res (os-eval-sexp val))
      (os-set-log log (os-sexp->str res) "butterscotch"))))))

(os-def-app sexp-inspector
  (title "List Inspector")
  (icon "L")
  (width 450)
  (height 340)
  (render (fn (win)
    (let log (os-win-add-log win))
    (let inp (os-win-add-input win "(+ 10 20 30)"))
    (os-win-add-button win "Inspect State List" (fn ()
      (let st (os-state-list))
      (os-set-log log (os-sexp->str st) "frosting")))
    (os-win-add-button win "Inspect Procs List" (fn ()
      (let pr (os-procs-list))
      (os-set-log log (os-sexp->str pr) "pistachio")))
    (os-win-add-button win "Eval Input S-Exp" (fn ()
      (let raw (os-get-value inp))
      (let res (os-eval-sexp raw))
      (os-set-log log (os-sexp->str res) "butterscotch"))))))

(os-def-app root-ext-builder
  (title "root/ Ext Builder")
  (icon "E")
  (width 450)
  (height 360)
  (render (fn (win)
    (let log (os-win-add-log win))
    (let ta (os-win-add-textarea win "(os-def-app hello-ext (title \"Hello Ext\") (icon \"H\") (width 320) (height 200) (render (fn (w) (os-win-add-text w \"Hello from root/user-ext.fe\" "pistachio"))))"))
    (os-win-add-button win "Save & Load root/user-ext.fe" (fn ()
      (let code (os-get-value ta))
      (os-write-file "root/user-ext.fe" code)
      (load "root/user-ext.fe")
      (os-set-log log "Loaded root/user-ext.fe into OS" "pistachio"))))))

(os-def-app sweetie-canvas
  (title "Sweetie Canvas")
  (icon "C")
  (width 360)
  (height 250)
  (render (fn (win)
    (os-win-add-text win "Sweetie-16 Desktop Canvas & Swatches" "butterscotch")
    (os-win-add-button win "Draw Sweetie Scene" (fn ()
      (os-canvas-clear)
      (os-canvas-rect 120 50 220 120 "blueberry" "frosting")
      (os-canvas-rect 150 75 90 60 "plum" "butterscotch")
      (os-canvas-line 120 190 360 190 "pistachio" 3)
      (os-canvas-text 132 158 "ALL IS A LIST (SWEETIE-16)" "marshmallow")))
    (os-win-add-button win "Clear Canvas" (fn ()
      (os-canvas-clear)))
    (os-win-add-swatches win))))

(print "[apps] built-in S-expression apps registered")
