(os-doc
  (title "jsfe Boot Loader")
  (kind system-boot)
  (philosophy "all is a list"))

(print "[boot] auto.fe evaluating system lists from root/...")
(load "root/sys.fe")
(load "root/apps.fe")
(os-log (quote (boot-complete (all-is-a-list t) (storage root-folder) (palette sweetie-16))))
(quote (booted root/auto.fe))
