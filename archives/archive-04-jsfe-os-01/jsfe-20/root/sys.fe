(os-doc
  (title "Core List Utilities & OS Helpers")
  (kind system-lib))

(= def (mac (name args . body)
  (list (quote =) name (list (quote fn) args (cons (quote do) body)))))

(def not-eq (a b)
  (not (is a b)))

(def cadr (xs)
  (car (cdr xs)))

(def caddr (xs)
  (car (cdr (cdr xs))))

(def assoc (key alist)
  (if (not alist)
      nil
      (let head (car alist)
        (if (is (car head) key)
            head
            (assoc key (cdr alist))))))

(def map (f xs)
  (if (not xs)
      nil
      (cons (f (car xs)) (map f (cdr xs)))))

(def filter (pred xs)
  (if (not xs)
      nil
      (if (pred (car xs))
          (cons (car xs) (filter pred (cdr xs)))
          (filter pred (cdr xs)))))

(def foldl (f acc xs)
  (if (not xs)
      acc
      (foldl f (f acc (car xs)) (cdr xs))))

(def length (xs)
  (foldl (fn (n _) (+ n 1)) 0 xs))

(def append (a b)
  (if (not a)
      b
      (cons (car a) (append (cdr a) b))))

(def make-note (title body)
  (list (quote note)
    (list (quote title) title)
    (list (quote body) body)
    (list (quote ts) (os-now))))

(print "[sys] core list combinators loaded from root/sys.fe")
(quote sys-ready)
