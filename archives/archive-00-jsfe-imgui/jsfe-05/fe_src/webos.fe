; ============================================================================
; webos.fe — WebOS Shell Orchestrator
; ============================================================================
(= webos/boot (fn ()
  (fs/boot)
  (if (not (fs/read-file "/hello.fe"))
      (fs/write-file "/hello.fe"
        "(do\n  (print \"Welcome to fe WebOS!\")\n  (list 'os 'fe-lisp 'storage 'sqlite-sexpr))"))
  (edit/cmd-open "/hello.fe")
  (edit/render)))

(print "Loaded webos.fe")
