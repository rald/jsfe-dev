{
  "name": "jsfe",
  "version": "1.0.0",
  "description": "Zero-dependency ES6 implementation of rxi/fe for Web and CLI",
  "type": "module",
  "main": "./fe.js",
  "exports": {
    ".": "./fe.js",
    "./repl": "./repl.js"
  },
  "bin": {
    "jsfe": "./repl.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node repl.js",
    "repl": "node repl.js",
    "showcase": "node repl.js showcase.fe",
    "test": "node --test test.js",
    "serve": "npx serve ."
  },
  "keywords": [
    "lisp",
    "interpreter",
    "fe",
    "rxi-fe",
    "es6",
    "esm",
    "repl"
  ],
  "license": "MIT"
}
